# OSGi Whiteboard Specification for Jakarta Servlet (R8.1, chapter 140) and
# the legacy OSGi Http Service (javax.servlet based, compatibility layer).
Export-Package: org.osgi.service.servlet.context, \
                org.osgi.service.servlet.runtime, \
                org.osgi.service.servlet.runtime.dto, \
                org.osgi.service.servlet.whiteboard, \
                org.osgi.service.http
Private-Package: org.glassfish.osgihttp.*
Bundle-Activator: org.glassfish.osgihttp.Activator
# javax.servlet and the Apache Felix javax/jakarta servlet wrappers are only
# needed by the HttpService compatibility layer, which is enabled when both
# bundles are installed.
Import-Package: com.sun.enterprise.web; version=${glassfish.version}, \
                org.glassfish.embeddable; version=0, \
                javax.servlet.*; version="[3.1,5)"; resolution:=optional, \
                org.apache.felix.http.jakartawrappers; version="[1.2,2)"; resolution:=optional, \
                org.apache.felix.http.javaxwrappers; version="[1.2,2)"; resolution:=optional, \
                *
Provide-Capability: osgi.implementation; \
                      osgi.implementation="osgi.http"; \
                      version:Version="2.0"; \
                      uses:="jakarta.servlet,jakarta.servlet.http,org.osgi.service.servlet.context,org.osgi.service.servlet.whiteboard", \
                    osgi.service; \
                      objectClass:List<String>="org.osgi.service.servlet.runtime.HttpServiceRuntime"; \
                      uses:="org.osgi.service.servlet.runtime,org.osgi.service.servlet.runtime.dto"
