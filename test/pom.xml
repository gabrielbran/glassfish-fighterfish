<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.glassfish.fighterfish</groupId>
        <artifactId>fighterfish-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>fighterfish-test-parent</artifactId>
    <name>FighterFish Test Parent</name>
    <packaging>pom</packaging>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <osgi.includefile>${basedir}/osgi.properties</osgi.includefile>
        <!-- JVM options required by GlassFish 8 on JDK 21+, see domain.xml -->
        <glassfish.jvm.options>--add-exports=java.base/jdk.internal.loader=ALL-UNNAMED --add-exports=java.base/jdk.internal.vm.annotation=ALL-UNNAMED --add-exports=java.naming/com.sun.jndi.ldap=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/jdk.internal.vm.annotation=ALL-UNNAMED --add-opens=java.base/sun.net.www.protocol.jrt=ALL-UNNAMED --add-opens=java.base/sun.nio.fs=ALL-UNNAMED --add-opens=java.naming/javax.naming.spi=ALL-UNNAMED --add-opens=java.rmi/sun.rmi.transport=ALL-UNNAMED --add-opens=jdk.management/com.sun.management.internal=ALL-UNNAMED -Djdk.attach.allowAttachSelf=true -Djava.awt.headless=true -Djavax.xml.accessExternalSchema=all -Djdk.xml.totalEntitySizeLimit=50000000 -Djava.security.auth.login.config=${glassfish.install.dir}/domains/domain1/config/login.conf -Djavax.net.ssl.keyStore=${glassfish.install.dir}/domains/domain1/config/keystore.p12 -Djavax.net.ssl.trustStore=${glassfish.install.dir}/domains/domain1/config/cacerts.p12</glassfish.jvm.options>
    </properties>

    <modules>
        <module>ct/misc/bundle</module>
        <module>util</module>
        <module>app</module>
        <module>it</module>
    </modules>
</project>
